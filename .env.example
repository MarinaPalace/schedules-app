# Postgres connection string (Neon or Supabase, pooled). Leave empty to use the embedded local PGlite database.
DATABASE_URL=
# Local PGlite data folder (only used when DATABASE_URL is empty)
PGLITE_DIR=./.pglite
# Random 32+ character secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Public address of the app, used in links inside emails/Telegram (https in production)
APP_URL=http://localhost:3000

# --- Email (optional) – any SMTP provider: Gmail app password, Brevo, Resend, your hosting...
# smtps://USER:PASSWORD@smtp.example.com:465   or   smtp://USER:PASSWORD@smtp.example.com:587
SMTP_URL=
MAIL_FROM="Hotel Schedules <schedules@your-hotel.bg>"

# --- Telegram (optional) – create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string; Telegram sends it with every update so the app knows the call is genuine
TELEGRAM_WEBHOOK_SECRET=
